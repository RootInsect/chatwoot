# Jingqi NewAPI — 复制为部署目录 .env 后改真实值
# 推荐目录：/opt/1panel/apps/new-api

# --- 镜像 ---
NEW_API_IMAGE=calciumion/new-api
NEW_API_IMAGE_TAG=latest

# --- 对外端口（宿主机）；若与 Chatwoot prod 3000 冲突请改，例如 3010 ---
HOST_PORT=3010

# --- PostgreSQL（生产推荐；勿用默认弱密码）---
POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=new-api

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- 会话 / 加密（多节点必须一致且保密）---
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# 可省略；省略时与 SESSION_SECRET 相同
# CRYPTO_SECRET=

# --- 其它 ---
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
MEMORY_CACHE_ENABLED=true
NODE_NAME=new-api-node-1
DEFAULT_LANGUAGE=zh-CN
