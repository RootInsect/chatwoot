# Jingqi Chatwoot — 测试环境模板（chatwoot-test，随时覆盖）
# 用法：
#   ./deploy/bootstrap-env.sh test /opt/1panel/apps/chatwoot/chatwoot-test
# 或手动：
#   cp deploy/env/chatwoot-test.env.example <部署目录>/.env
#   cp deploy/compose.yml <部署目录>/compose.yml
# 然后把所有 CHANGE_ME 改成真实值（SECRET / DB / Redis / SMTP）

# --- 必填密钥（每台机器 / 每个环境各自生成，勿提交真实值）---
SECRET_KEY_BASE=CHANGE_ME_openssl_rand_hex_64
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# REDIS_URL 里的密码必须与 REDIS_PASSWORD 一致
REDIS_URL=redis://:CHANGE_ME@redis:6379
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# --- 部署 / 镜像 ---
IMAGE=100.65.76.62:5000/jingqi/chatwoot
IMAGE_TAG=test-latest
HOST_PORT=3004

# --- 站点 ---
FRONTEND_URL=https://chat-test.jingqiweb.com
DEFAULT_LOCALE=zh_CN
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=true
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true

# --- 数据库（compose 内服务名；与正式 / dev 隔离）---
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot_production

# --- 邮件 ---
MAILER_SENDER_EMAIL=景齐 <CHANGE_ME@example.com>
SMTP_ADDRESS=smtp.163.com
SMTP_DOMAIN=163.com
SMTP_PORT=465
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=true
SMTP_OPENSSL_VERIFY_MODE=peer
