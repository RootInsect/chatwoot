# 本地 / 开发机 .env 模板（复制到仓库根目录 .env）
#   cp deploy/env/development.env.example .env
# 勿提交真实 .env

SECRET_KEY_BASE=CHANGE_ME_run_rails_secret_or_openssl_rand_hex_64

FRONTEND_URL=http://localhost:3001
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true
DEFAULT_LOCALE=zh_CN

RAILS_ENV=development
NODE_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5

# 对应 deploy/compose.dev-deps.yml（宿主机映射端口，避免与本机其它服务冲突）
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
# 开发库名可由 Rails 默认 chatwoot_development；显式指定亦可
# POSTGRES_DATABASE=chatwoot_development

REDIS_URL=redis://localhost:56379
REDIS_PASSWORD=

# 本地可先不配真 SMTP；需要收信时再填
MAILER_SENDER_EMAIL=Dev <dev@localhost>
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

INSTALLATION_ENV=dev
