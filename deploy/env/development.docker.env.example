# Docker 源码挂载开发用 .env 模板
#   复制到仓库根目录 .env（或由 deploy/dev-docker-up.* 自动生成）
# 勿提交真实 .env
#
# 与 deploy/compose.dev.yml 配套：Postgres/Redis 用服务名，不是 localhost。

SECRET_KEY_BASE=CHANGE_ME_run_rails_secret_or_openssl_rand_hex_64

FRONTEND_URL=http://localhost:3001
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true
DEFAULT_LOCALE=zh_CN

RAILS_ENV=development
NODE_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
# 可留空；Rails 开发默认库名 chatwoot_development
# POSTGRES_DATABASE=chatwoot_development

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

MAILER_SENDER_EMAIL=Dev <dev@localhost>
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_DOMAIN=localhost
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

INSTALLATION_ENV=dev
